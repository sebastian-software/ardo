{
  "name": "ardo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "React-first Static Documentation Framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ardo.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter ardo dev",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest --run --config vitest.config.ts",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:coverage": "vitest --run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:examples": "playwright test --config tests/e2e/examples/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "node scripts/check-lint-budget.mjs",
    "lint:raw": "oxlint --type-aware packages/*/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "pnpm -r --filter ./docs dev",
    "docs:build": "pnpm -r --filter './docs' build",
    "docs:prepare-pages": "node scripts/prepare-pages-artifact.mjs",
    "docs:budgets": "node scripts/check-budgets.mjs",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "STORYBOOK_BASE=/storybook/ storybook build --output-dir storybook-static",
    "storybook:build:test": "storybook build --output-dir storybook-static",
    "storybook:serve": "http-server storybook-static -a 127.0.0.1 -p 6006 -s",
    "storybook:test": "test-storybook --url http://127.0.0.1:6006",
    "prepare": "husky"
  },
  "keywords": [
    "documentation",
    "static-site",
    "react",
    "react-router",
    "mdx",
    "typedoc",
    "markdown",
    "docs"
  ],
  "author": "Sebastian Software GmbH",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-config-setup": "^0.5.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "typescript": "7.1.0-dev.20261011.1",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "lint-staged": {
    "*.{ts,tsx,js,json,md,mdx,yml,yaml}": "prettier --write"
  }
}
