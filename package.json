{
  "name": "ardo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "React-first Static Documentation Framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ardo.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter ardo dev",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest --run --config vitest.config.ts",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:coverage": "vitest --run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:examples": "playwright test --config tests/e2e/examples/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "node scripts/check-lint-budget.mjs",
    "lint:raw": "oxlint --type-aware packages/*/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "pnpm -r --filter ./docs dev",
    "docs:build": "pnpm -r --filter './docs' build",
    "docs:prepare-pages": "node scripts/prepare-pages-artifact.mjs",
    "docs:budgets": "node scripts/check-budgets.mjs",
    "prepare": "husky",
    "test:e2e:docs-dev": "playwright test --config tests/e2e/docs-development/playwright.config.ts"
  },
  "keywords": [
    "documentation",
    "static-site",
    "react",
    "mdx",
    "typedoc",
    "markdown",
    "docs"
  ],
  "author": "Sebastian Software GmbH",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-config-setup": "^0.5.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "lint-staged": {
    "*.{ts,tsx,js,json,md,mdx,yml,yaml}": "prettier --write"
  }
}
