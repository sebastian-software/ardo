{
  "name": "ardo",
  "version": "5.0.0",
  "description": "React-first Static Documentation Framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./mdx-provider": {
      "types": "./dist/mdx/provider.d.ts",
      "import": "./dist/mdx/provider.js"
    },
    "./press.css": "./dist/ui/styles.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/react/jsx-runtime.d.ts",
      "import": "./dist/react/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/react/jsx-dev-runtime.d.ts",
      "import": "./dist/react/jsx-dev-runtime.js"
    },
    "./react-dom": {
      "types": "./dist/react-dom/index.d.ts",
      "import": "./dist/react-dom/index.js"
    },
    "./react-dom/client": {
      "types": "./dist/react-dom/client.d.ts",
      "import": "./dist/react-dom/client.js"
    },
    "./react-dom/server": {
      "types": "./dist/react-dom/server.d.ts",
      "import": "./dist/react-dom/server.js"
    },
    "./react-dom/static": {
      "types": "./dist/react-dom/static.d.ts",
      "import": "./dist/react-dom/static.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./router/dom": {
      "types": "./dist/router/dom.d.ts",
      "import": "./dist/router/dom.js"
    },
    "./router/routes": {
      "types": "./dist/router/routes.d.ts",
      "import": "./dist/router/routes.js"
    },
    "./package.json": "./package.json",
    "./vite/client": {
      "types": "./vite-client.d.ts"
    },
    "./entry.server": {
      "types": "./dist/entries/server.d.ts",
      "import": "./dist/entries/server.js"
    }
  },
  "sideEffects": [
    "*.css",
    "*.css.ts",
    "*.css.js"
  ],
  "files": [
    "ICONS-LICENSE.md",
    "dist",
    "virtual.d.ts",
    "vite-client.d.ts",
    "bin"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "icons:generate": "svgr --out-dir src/ui/icons/sections .icon-sources/sections && svgr --out-dir src/ui/icons/chrome .icon-sources/chrome && oxlint --fix src/ui/icons/sections src/ui/icons/chrome && prettier --write src/ui/icons"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ferriki/core": "^1.1.2",
    "@react-router/dev": "8.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "ferromark": "^3.5.1",
    "lucide-react": "^1.29.0",
    "minisearch": "^7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "read-package-up": "^12.0.0",
    "vite": "8.2.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "oxc-parser": "^0.127.0",
    "typescript": "^7.1.0-dev.20261011.1"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@svgr/cli": "8.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "oxc-parser": "^0.127.0",
    "tsdown": "^0.22.14",
    "typescript": "7.1.0-dev.20261011.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "documentation",
    "static-site",
    "react",
    "react-router",
    "mdx",
    "markdown",
    "docs"
  ],
  "author": "Sebastian Software GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ardo.git",
    "directory": "packages/ardo"
  },
  "homepage": "https://ardo-docs.dev",
  "bugs": {
    "url": "https://github.com/sebastian-software/ardo/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebastian-software"
  },
  "bin": {
    "ardo": "./bin/ardo.js"
  },
  "svgr": {
    "typescript": true,
    "jsxRuntime": "automatic",
    "dimensions": false,
    "svgo": true,
    "svgoConfig": {
      "plugins": [
        {
          "name": "preset-default",
          "params": {
            "overrides": {
              "removeViewBox": false,
              "removeDesc": {
                "removeAny": true
              }
            }
          }
        },
        "removeXMLNS"
      ]
    }
  }
}
