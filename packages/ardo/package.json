{
  "name": "ardo",
  "version": "5.0.0",
  "description": "React-first Static Documentation Framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./mdx-provider": {
      "types": "./dist/mdx/provider.d.ts",
      "import": "./dist/mdx/provider.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/react/jsx-runtime.d.ts",
      "import": "./dist/react/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/react/jsx-dev-runtime.d.ts",
      "import": "./dist/react/jsx-dev-runtime.js"
    },
    "./react-dom": {
      "types": "./dist/react-dom/index.d.ts",
      "import": "./dist/react-dom/index.js"
    },
    "./react-dom/client": {
      "types": "./dist/react-dom/client.d.ts",
      "import": "./dist/react-dom/client.js"
    },
    "./react-dom/server": {
      "types": "./dist/react-dom/server.d.ts",
      "import": "./dist/react-dom/server.js"
    },
    "./react-dom/static": {
      "types": "./dist/react-dom/static.d.ts",
      "import": "./dist/react-dom/static.js"
    },
    "./package.json": "./package.json",
    "./tsconfig": "./tsconfig.app.json",
    "./vite/client": {
      "types": "./vite-client.d.ts"
    }
  },
  "sideEffects": [
    "*.css",
    "*.css.ts",
    "*.css.js",
    "./dist/entries/*.js",
    "./src/entries/*.tsx"
  ],
  "files": [
    "CHANGELOG.md",
    "ICONS-LICENSE.md",
    "dist",
    "virtual.d.ts",
    "vite-client.d.ts",
    "bin",
    "tsconfig.app.json"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "icons:generate": "svgr --out-dir src/ui/icons/sections .icon-sources/sections && svgr --out-dir src/ui/icons/chrome .icon-sources/chrome && svgr --out-dir src/ui/icons/content .icon-sources/content && oxlint --fix src/ui/icons/sections src/ui/icons/chrome src/ui/icons/content && prettier --write src/ui/icons"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ferriki/core": "^1.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "ferrolink": "^0.2.1",
    "ferromark": "^3.5.1",
    "minisearch": "^7.2.0",
    "oxc-transform-react": "^0.152.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "read-package-up": "^12.0.0",
    "vite": "catalog:",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "oxc-parser": "^0.155.0 || ^0.156.0",
    "typescript": ">=6.0.0 || ^7.1.0-dev.20261011.1"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "oxc-parser": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "documentation",
    "static-site",
    "react",
    "mdx",
    "markdown",
    "docs"
  ],
  "author": "Sebastian Software GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ardo.git",
    "directory": "packages/ardo"
  },
  "homepage": "https://ardo-docs.dev",
  "bugs": {
    "url": "https://github.com/sebastian-software/ardo/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebastian-software"
  },
  "bin": {
    "ardo": "./bin/ardo.js"
  },
  "svgr": {
    "typescript": true,
    "jsxRuntime": "automatic",
    "dimensions": false,
    "svgo": true,
    "svgoConfig": {
      "plugins": [
        {
          "name": "preset-default",
          "params": {
            "overrides": {
              "removeViewBox": false,
              "removeDesc": {
                "removeAny": true
              }
            }
          }
        },
        "removeXMLNS"
      ]
    }
  }
}
